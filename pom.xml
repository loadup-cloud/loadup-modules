<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.loadup-cloud</groupId>
        <artifactId>loadup-framework</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../loadup-framework/pom.xml</relativePath>
    </parent>
    <groupId>io.github.loadup-cloud</groupId>
    <artifactId>loadup-modules</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <packaging>pom</packaging>
    <name>LoadUp Modules</name>
    <description>Reusable business capabilities organized with COLA application layers.</description>
    <url>https://github.com/loadup-cloud</url>
    <inceptionYear>2025</inceptionYear>
    <organization>
        <name>loadup_cloud</name>
    </organization>
    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>Laysan</id>
            <name>Laysan</name>
            <email>lslvxy@gmail.com</email>
        </developer>
    </developers>
    <modules>
        <module>loadup-modules-bom</module>
        <module>loadup-modules-upms</module>
        <module>loadup-modules-audit</module>
        <module>loadup-modules-dictionary</module>
        <module>loadup-modules-file</module>
        <module>loadup-modules-form</module>
        <module>loadup-modules-approval</module>
        <module>loadup-modules-gotone</module>
        <module>loadup-modules-inbox</module>
        <module>loadup-modules-transfer</module>
    </modules>
    <scm>
        <connection>scm:git:https://github.com/loadup-cloud/loadup-modules.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/loadup-cloud/loadup-modules.git</developerConnection>
        <url>https://github.com/loadup-cloud/loadup-modules</url>
    </scm>
    <properties>
        <!-- Keep the Framework BOM aligned with the Framework parent and Modules BOM. -->
        <loadup.framework.version>0.0.1-SNAPSHOT</loadup.framework.version>
        <loadup.testify.version>0.0.1-SNAPSHOT</loadup.testify.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.loadup-cloud</groupId>
                <artifactId>loadup-modules-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.loadup-cloud</groupId>
                <artifactId>loadup-testify-bom</artifactId>
                <version>${loadup.testify.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <repositories>
        <!-- Resolve the Framework parent when Modules is checked out on its own. -->
        <repository>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
            <id>github</id>
            <url>https://maven.pkg.github.com/loadup-cloud/loadup-packages</url>
        </repository>
    </repositories>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                    <configuration>
                        <archive>
                            <manifest>
                                <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            </manifest>
                        </archive>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration/>
            </plugin>
        </plugins>
    </build>
</project>
